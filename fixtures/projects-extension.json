            "focusTruePaths": [
              "focus.focused",
              "focus.focusVisible",
              "focus.inViewport",
              "focus.pulsed"
            ],
            "denominatorPaths": [
              "workspaceBefore",
              "workspaceAfter"
            ],
            "humanGateTruePaths": [
              "requiresHumanStart"
