{
  "name": "webmcp-conformance-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "webmcp-conformance-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@webmcp-conformance/webmcp-discovery-host": {
      "resolved": "packages/webmcp-discovery-host",
      "link": true
    },
    "node_modules/@webmcp-conformance/wornpage-consumer-check": {
      "resolved": "packages/wornpage-consumer-check",
      "link": true
    },
    "node_modules/webmcp-conformance": {
      "resolved": "packages/webmcp-conformance",
      "link": true
    },
    "packages/webmcp-conformance": {
      "version": "0.1.0",
      "bin": {
        "webmcp-conformance": "src/cli.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/webmcp-discovery-host": {
      "name": "@webmcp-conformance/webmcp-discovery-host",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "webmcp-conformance": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/wornpage-consumer-check": {
      "name": "@webmcp-conformance/wornpage-consumer-check",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "wornpage-consumer-check": "bin/wornpage-consumer-check.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
